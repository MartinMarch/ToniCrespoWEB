{
  "name": "tonicrespo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "tsc -b --noEmit",
    "lint:tests": "tsc --project tsconfig.tests.json",
    "test:rooms": "node scripts/test-artwork-room-geometry.mjs",
    "test:poem": "node scripts/test-poem-attribution.mjs",
    "test:artwork-text": "node scripts/test-artwork-editorial-text.mjs",
    "test:home-editor:browser": "node scripts/test-home-editor-browser.mjs",
    "test:rooms:browser": "node scripts/test-artwork-rooms-browser.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:e2e": "playwright test",
    "test:components": "node tests/helpers/browser-components.mjs",
    "test:ci": "npm run lint && npm run lint:tests && npm test && npm run test:components && npm run build",
    "test:supabase": "node scripts/test-supabase-editing.mjs",
    "supabase:test:start": "node tests/helpers/local-supabase.mjs start",
    "supabase:test:stop": "node tests/helpers/local-supabase.mjs stop",
    "test:supabase:local": "node tests/helpers/local-supabase.mjs test",
    "test:public-health": "node tests/integration/public-health.mjs",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "verify:supabase-backup": "node scripts/verify-supabase-backup.mjs",
    "backup:supabase": "node scripts/backup-supabase.mjs",
    "restore:supabase": "node scripts/restore-supabase-backup.mjs",
    "capture:mockups": "node scripts/capture-client-mockups.mjs",
    "capture:mockups:editing": "node scripts/capture-client-mockups.mjs --editing-only",
    "render:mockups-pdf": "node scripts/render-client-mockups-pdf.mjs",
    "preview:pages": "node scripts/preview-github-pages.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "supabase": "2.116.0",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.2"
  }
}
